# Edezee backend configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM provider (OpenRouter-compatible) -------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model used for drafting slides. Any OpenRouter model id works.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional attribution headers OpenRouter uses for its public leaderboard.
OPENROUTER_SITE_URL=https://github.com/juwwad/edezee
OPENROUTER_APP_NAME=Edezee

# --- Research provider (Tavily) ----------------------------------------
# Optional. When unset, Edezee falls back to model-internal knowledge and
# marks each slide's grounding as "model-knowledge".
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=4

# --- Pipeline behaviour -------------------------------------------------
# Per-topic LLM attempts before the topic is marked as failed.
MAX_TOPIC_ATTEMPTS=3
# Seconds to wait for a single LLM call before retrying.
LLM_TIMEOUT_SECONDS=90
# Hard cap on topics accepted in one request (protects against token blowups).
MAX_TOPICS=40
# Seconds to sleep between topics (keeps free-tier rate limits happy).
INTER_TOPIC_DELAY_SECONDS=0

# --- Server -------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
